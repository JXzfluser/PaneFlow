    "type": [
     "string",
     "null"
    ]
   },
   "workspace_id": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "direction"
  ],
  "type": "object"
 },
 "pane.read": {
  "properties": {
   "format": {
    "$desc": "ReadFormat",
    "enum": [
     "text",
     "ansi"
    ],
