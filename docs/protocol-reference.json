  "type": "object"
 },
 "session.snapshot": {
  "type": "object"
 },
 "workspace.create": {
  "properties": {
   "cwd": {
    "type": [
     "string",
     "null"
    ]
   },
   "env": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "focus": {
    "default": false,
    "type": "boolean"
   },
   "label": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "workspace.list": {
  "type": "object"
 },
 "workspace.close": {
  "properties": {
   "workspace_id": {
    "type": "string"
   }
  },
  "required": [
   "workspace_id"
  ],
  "type": "object"
 },
 "agent.list": {
  "type": "object"
 },
 "agent.get": {
  "properties": {
   "target": {
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "agent.read": {
  "properties": {
   "format": {
    "$desc": "ReadFormat",
    "enum": [
     "text",
     "ansi"
    ],
    "type": "string"
   },
   "lines": {
    "format": "uint32",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "source": {
    "$desc": "ReadSource",
    "enum": [
     "visible",
     "recent",
     "recent_unwrapped",
     "detection"
    ],
    "type": "string"
   },
   "strip_ansi": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   }
  },
  "required": [
   "target",
   "source"
  ],
  "type": "object"
 },
 "agent.send_keys": {
  "properties": {
   "keys": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target": {
    "type": "string"
   }
  },
  "required": [
   "target",
   "keys"
  ],
  "type": "object"
 },
 "agent.start": {
  "properties": {
   "args": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "kind": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "pane_id": {
    "type": "string"
   },
   "timeout_ms": {
    "description": "Startup timeout in milliseconds. Values must be greater than 3000 and at most 300000.",
    "format": "uint64",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "name",
   "kind",
   "pane_id"
  ],
  "type": "object"
 },
 "agent.prompt": {
  "properties": {
   "target": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "wait": {
    "anyOf": [
     {
      "$desc": "AgentPromptWaitOptions",
      "properties": {
       "timeout_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "until": {
        "items": {
         "$ref": "#/schemas/request/$defs/AgentStatus"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "target",
   "text"
  ],
  "type": "object"
 },
 "agent.wait": {
  "properties": {
   "target": {
    "type": "string"
   },
   "timeout_ms": {
    "format": "uint64",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "until": {
    "items": {
     "$desc": "AgentStatus",
     "enum": [
      "idle",
      "working",
      "blocked",
      "done",
      "unknown"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
