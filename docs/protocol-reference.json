 "pane.wait_for_output": {
  "properties": {
   "lines": {
    "format": "uint32",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "match": {
    "$desc": "OutputMatch",
    "oneOf": [
     {
      "properties": {
       "type": {
        "const": "substring",
        "type": "string"
       },
       "value": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "regex",
        "type": "string"
       },
       "value": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "type": "object"
     }
    ]
   },
   "pane_id": {
    "type": "string"
   },
   "source": {
    "$desc": "ReadSource",
    "enum": [
     "visible",
     "recent",
     "recent_unwrapped",
     "detection"
    ],
    "type": "string"
   },
   "strip_ansi": {
    "default": true,
    "type": "boolean"
   },
   "timeout_ms": {
    "format": "uint64",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "pane_id",
   "source",
   "match"
  ],
  "type": "object"
 }
}